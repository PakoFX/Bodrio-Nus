<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Fondo elegante institucional UV (Azul marino profundo con degradado) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#0D1E3A" android:offset="0.0" />
                <item android:color="#081426" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Resplandor sutil esmeralda/azul UV en la esquina superior -->
    <path android:pathData="M0,0 L70,0 L0,70 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="50"
                android:endY="50"
                android:type="linear">
                <item android:color="#1A00843D" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Círculo concéntrico sutil de diseño de fondo -->
    <path
        android:strokeColor="#15FFFFFF"
        android:strokeWidth="1.2"
        android:pathData="M 54, 54 m -38, 0 a 38,38 0 1,0 76,0 a 38,38 0 1,0 -76,0" />

