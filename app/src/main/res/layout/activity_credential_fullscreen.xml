<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0F172A"
        app:navigationIcon="@drawable/ic_nav_back"
        app:navigationIconTint="#FFFFFF"
        app:title="Credencial Digital UV"
        app:titleTextColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp">

            <!-- Reloj Antifraude Flotante -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_live"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot_accent"
                    android:layout_marginEnd="8dp" />

                <TextClock
                    android:id="@+id/clockLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="dd MMM yyyy, hh:mm:ss a"
                    android:format24Hour="dd MMM yyyy, HH:mm:ss 'hrs.'"
                    android:textColor="#2E7D32"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tarjeta de la Credencial -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCredential"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Encabezado Institucional UV -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_credential_header"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UNIVERSIDAD VERACRUZANA"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="CREDENCIAL DIGITAL • ESTUDIANTE"
                            android:textColor="#B2DFDB"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.03" />
                    </LinearLayout>

                    <!-- Franja de color institucional delgado -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:background="#0284C7" />

                    <!-- Contenido Central: Foto y Datos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="20dp">

                        <!-- Foto oficial con marco -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            app:cardCornerRadius="55dp"
                            app:cardElevation="3dp"
                            app:strokeWidth="3dp"
                            app:strokeColor="#00796B">

                            <ImageView
                                android:id="@+id/imgStudentPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_nav_profile"
                                android:contentDescription="Fotografía del estudiante" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Nombre Completo -->
                        <TextView
                            android:id="@+id/txtFullStudentName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:text="NOMBRE DEL ESTUDIANTE"
                            android:textColor="#0F172A"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- Matrícula -->
                        <TextView
                            android:id="@+id/txtFullStudentId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_pill_badge"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="5dp"
                            android:text="zs00000000"
                            android:textColor="#0284C7"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <!-- Carrera / Programa Educativo -->
                        <TextView
                            android:id="@+id/txtProgram"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="Licenciatura / Ingeniería"
                            android:textColor="#334155"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Región / Campus -->
                        <TextView
                            android:id="@+id/txtRegion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:text="Región Xalapa"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <!-- Vigencia -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_stat_pill"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vigencia: "
                                android:textColor="#64748B"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/txtValidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FEB - JUL 2026"
                                android:textColor="#0F172A"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Divisor -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="16dp"
                            android:background="#E2E8F0" />

                        <!-- Código QR de Validación Oficial -->
                        <ImageView
                            android:id="@+id/imgQrCode"
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:contentDescription="Código QR de verificación"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Código QR de Validación Institucional"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />

                        <!-- Código de Barras Lineal (Code 128) -->
                        <ImageView
                            android:id="@+id/imgBarCode"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="12dp"
                            android:contentDescription="Código de barras institucional"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/txtBarCodeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="*ZS00000000*"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:letterSpacing="0.1" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Esta credencial funciona 100% sin conexión a internet"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

