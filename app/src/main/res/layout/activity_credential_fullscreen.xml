<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_uv_credential_watermark"
    android:fitsSystemWindows="true">

    <!-- Contenido scrolleable de la credencial oficial (sin barra de navegación para fidelidad 100%) -->
    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomClock">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Fila superior: "Estudiante" y Logo UV Oficial -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtHeaderEstudiante"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Estudiante"
                    android:textColor="#0D47A1"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <ImageView
                    android:id="@+id/imgLogoUv"
                    android:layout_width="72dp"
                    android:layout_height="64dp"
                    android:layout_alignParentEnd="true"
                    android:adjustViewBounds="true"
                    android:contentDescription="Universidad Veracruzana"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_uv_header" />
            </RelativeLayout>

            <!-- Fotografía oficial del estudiante (rectangular) -->
            <ImageView
                android:id="@+id/imgStudentPhoto"
                android:layout_width="104dp"
                android:layout_height="132dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="#E2E8F0"
                android:contentDescription="Fotografía del estudiante"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_nav_profile" />

            <!-- Datos institucionales alineados a la izquierda -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Nombre -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre"
                    android:textColor="#0D47A1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtFullStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Francisco Xavier Viveros Salmones"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Programa educativo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programa educativo"
                    android:textColor="#0D47A1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtProgram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Ingeniería de Software"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Campus -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Campus"
                    android:textColor="#0D47A1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtRegion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Coatzacoalcos"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Matrícula -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Matrícula"
                    android:textColor="#0D47A1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtFullStudentId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="S24022198"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Vigencia -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vigencia"
                    android:textColor="#0D47A1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtValidity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="AGO-ENE 2027"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Código QR Oficial UV en azul institucional -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:background="#FFFFFF"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/imgQrCode"
                    android:layout_width="168dp"
                    android:layout_height="168dp"
                    android:contentDescription="Código QR Oficial"
                    android:scaleType="fitCenter" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Barra inferior negra con Reloj Antifraude Oficial -->
    <LinearLayout
        android:id="@+id/layoutBottomClock"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#000000"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/txtLiveClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FBFF03"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="08/nov/2026 17:59:57" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
