<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_nav_back"
            app:navigationIconTint="#FFFFFF"
            app:title="Visor de Documento"
            app:titleTextColor="#FFFFFF"
            app:subtitleTextColor="#94A3B8" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido Principal -->
    <FrameLayout
        android:id="@+id/containerContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Estado de Carga -->
        <LinearLayout
            android:id="@+id/layoutLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#38BDF8" />

            <TextView
                android:id="@+id/txtLoadingMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Descargando recurso para visualización en línea…"
                android:textColor="#E2E8F0"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Visor PDF: Lista de páginas renderizadas nativamente -->
        <FrameLayout
            android:id="@+id/layoutPdfViewer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPdfPages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="12dp"
                android:paddingHorizontal="8dp" />

            <!-- Contador flotante de páginas -->
            <TextView
                android:id="@+id/txtPageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_stat_pill"
                android:backgroundTint="#80000000"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Páginas: 4" />
        </FrameLayout>

        <!-- Visor de Imágenes -->
        <FrameLayout
            android:id="@+id/layoutImageViewer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgFullScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="Imagen"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <!-- Visor de Texto / Código -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutTextViewer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtFileContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:textColor="#E2E8F0"
                android:textSize="13sp" />
        </androidx.core.widget.NestedScrollView>

        <!-- Visor Web para Office (DOCX, PPTX) y HTML en línea -->
        <WebView
            android:id="@+id/webOfficeViewer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0F172A"
            android:visibility="gone" />

        <!-- Visor Office Fallback (ZIP, RAR, etc.) -->
        <LinearLayout
            android:id="@+id/layoutOfficeViewer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/txtOfficeEmoji"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_stat_pill"
                        android:backgroundTint="#334155"
                        android:gravity="center"
                        android:textSize="36sp"
                        tools:text="📙" />

                    <TextView
                        android:id="@+id/txtOfficeFileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Presentacion_Proyecto.pptx" />

                    <TextView
                        android:id="@+id/txtOfficeFileInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        tools:text="210 KB · Presentación de PowerPoint" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="Este archivo se descargó de forma segura en la memoria de la aplicación. Puedes abrirlo con cualquier lector de Office instalado en tu teléfono o guardarlo en tus descargas."
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenOfficeExternal"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="#00897B"
                        android:text="Abrir con visor de Office"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_open_in_new"
                        app:iconGravity="textStart"
                        app:iconTint="#FFFFFF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveOfficeCopy"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:text="Guardar copia en Descargas"
                        android:textColor="#38BDF8"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_file_download"
                        app:iconGravity="textStart"
                        app:iconTint="#38BDF8"
                        app:strokeColor="#38BDF8" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Mensaje de Error -->
        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/txtErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="No se pudo abrir el documento"
                android:textColor="#EF4444"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Reintentar"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

