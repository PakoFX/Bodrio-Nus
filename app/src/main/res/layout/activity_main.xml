<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Barra de progreso de carga -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenedor con soporte para Pull to Refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Navegador WebView que ocupará toda la pantalla -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Barra de navegación flotante estilo isla (para regresar, volver a inicio o recargar) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navPill"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="23dp"
        app:cardElevation="6dp"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF"
        app:cardBackgroundColor="#E60A192F"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <!-- Botón Atrás -->
            <ImageButton
                android:id="@+id/btnNavBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Regresar"
                android:src="@drawable/ic_nav_back"
                app:tint="#FFFFFF" />

            <!-- Separador visual -->
            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="#26FFFFFF" />

            <!-- Botón Inicio (Volver directo a Cursos Eminus) -->
            <TextView
                android:id="@+id/btnNavHome"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="⌂ Eminus"
                android:textColor="#00E676"
                android:textStyle="bold"
                android:textSize="13sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <!-- Separador visual -->
            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="#26FFFFFF" />

            <!-- Botón Adelante -->
            <ImageButton
                android:id="@+id/btnNavForward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Adelante"
                android:src="@drawable/ic_nav_forward"
                app:tint="#FFFFFF" />

            <!-- Botón Recargar -->
            <ImageButton
                android:id="@+id/btnNavReload"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Recargar"
                android:src="@drawable/ic_nav_reload"
                app:tint="#FFFFFF" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Visor interno: popups de "Ver en línea" y PDFs, sin salir de la app -->
    <LinearLayout
        android:id="@+id/viewerOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FF0B1220"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#E60A192F"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/btnCerrarVisor"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:text="✕  Cerrar visor"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTituloVisor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="Ver en línea"
                android:textColor="#00E676"
                android:textSize="13sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/viewerProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/viewerWebContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/pdfScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#EEF2F6"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/pdfPages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp" />
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
